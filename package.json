{
  "name": "syllabusforge-root",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "start": "npm run dev:server",
    "dev": "concurrently -k \"npm run dev:server\" \"npm run dev:client\"",
    "test": "npm run test --workspace=shared",
    "seed": "npm run seed --workspace=server",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build --workspace=shared && npm run build --workspace=client && npm run build --workspace=server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
